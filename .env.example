# Copy to .env for local development:  cp .env.example .env
# On Render, set these in the dashboard (Environment tab) instead. Never commit a real .env.

# --- Platform -----------------------------------------------------------
# Render injects PORT automatically. Only set it locally.
PORT=3000
# Use NODE_ENV=development locally so localhost and test scripts are allowed.
NODE_ENV=production

# --- Browser access (CORS + WebSocket origin check) ----------------------
# Extra origins allowed IN ADDITION to the built-in CrazyGames defaults
# (https://*.crazygames.com, regional crazygames.* domains, 1001juegos.com).
# Comma separated. "https://*.example.com" matches any subdomain depth.
# Add your own test site here. "*" allows every website (not recommended).
ALLOWED_ORIGINS=

# Both default to false when NODE_ENV=production and true otherwise. Uncomment only to override.
# Accept connections with no Origin header (test scripts, curl):
# ALLOW_NO_ORIGIN=true
# Accept http://localhost:* and http://127.0.0.1:* :
# ALLOW_LOCALHOST=true

# --- Capacity (start small on Render Free: 0.1 CPU / 512 MB) ---------------
MAX_PLAYERS_PER_ROOM=20
MAX_ROOMS=2
# Humans + bots per arena. Bots fill the gap and step aside as humans join.
TARGET_POPULATION=20

# --- Simulation / network cost -------------------------------------------
TICK_RATE=30
SNAPSHOT_RATE=15
FOOD_TARGET=1400
BIG_FOOD_MAX=36
# Half-size of the box of food sent around each player (world units); grows with fruit size
FOOD_VIEW_X=1300
FOOD_VIEW_Y=900

# --- Sessions / hygiene --------------------------------------------------
# How long a dropped player's fruit stays in the arena so they can resume (ms, 0 = remove immediately)
RECONNECT_GRACE_MS=15000
# Remove players who send no input for this long (ms, 0 = disabled)
AFK_KICK_MS=60000
# Close empty arenas after this long (ms)
ROOM_IDLE_MS=60000
# Soft cap on simultaneous sockets per IP
MAX_CONN_PER_IP=6
